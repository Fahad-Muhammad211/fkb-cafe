# Copy to .env.local for local development, and set the same variables in your host's environment
# settings for deployments. Never commit .env.local.

# MongoDB Atlas connection string. Replace the password placeholder with the database user's
# password (URL-encode special characters). Keep the real value in .env.local only.
# All accounts, sessions and business records are stored here; the browser keeps none of them.
MONGODB_URI=
# Database name inside the cluster.
MONGODB_DB=restaurant_system

# Optional. Number of proxies in front of the app that append the visitor's address to X-Forwarded-For
# (1 on Vercel or behind a single nginx/Caddy reverse proxy). Leave empty when the app is reached
# directly: the header is then ignored and failed logins are limited per account only.
TRUSTED_PROXY_HOPS=
