# Copy to .env.local for local development, and set the same variable in Vercel
# (Project Settings → Environment Variables) for deployments.

# Secret used to sign admin session cookies. Use a long random value, for example the
# output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a secret is generated and saved to data/session-secret.txt (local only).
ADMIN_SESSION_SECRET=

# MongoDB Atlas connection string. Replace the password placeholder with the database user's
# password (URL-encode special characters). Keep the real value in .env.local only.
MONGODB_URI=
# Database name inside the cluster.
MONGODB_DB=meg
